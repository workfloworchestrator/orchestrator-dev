ENVIRONMENT_NAME="Orchestrator Minimal"
ORCHESTRATOR_API_HOST=http://localhost:8080
ORCHESTRATOR_API_PATH=/api
ORCHESTRATOR_GRAPHQL_HOST=http://localhost:8080
ORCHESTRATOR_GRAPHQL_PATH=/api/graphql
ORCHESTRATOR_WEBSOCKET_URL=ws://localhost:8080/api/ws/events
USE_WEB_SOCKETS=true
USE_THEME_TOGGLE=true
SHOW_WORKFLOW_INFORMATION_LINK=true
ENABLE_SUPPORT_MENU_ITEM=true
SUPPORT_MENU_ITEM_URL="https://workfloworchestrator.org/orchestrator-core/reference-docs/tldr/"
ENABLE_AO_STACK_STATUS=false
AO_STACK_STATUS_URL=""
START_WORKFLOW_FILTERS="active|pre_production|phase_out"
# Disable the external workflow info link in favor of new WORKFLOW_USER_GUIDE
SHOW_WORKFLOW_INFORMATION_LINK=false
# TODO This feature needs to be improved to configure the backend URL
SHOW_WORKFLOW_USER_GUIDE=true

# Disable cache - useful when in development
NEXT_PUBLIC_DISABLE_CACHE=false

# Auth variables
OAUTH2_ACTIVE=true
NEXTAUTH_PROVIDER_ID="keycloak"
NEXTAUTH_PROVIDER_NAME="Keycloak"
NEXTAUTH_AUTHORIZATION_SCOPE_OVERRIDE="openid profile email"
OAUTH2_CLIENT_ID=orchestrator-frontend
OAUTH2_CLIENT_SECRET="KEYCLOAK_SECRET"
# This should point to keycloak and be reachable by your browser (So localhost, not your container host)
OIDC_CONF_FULL_WELL_KNOWN_URL=http://127.0.0.1:8085/realms/orchestrator/.well-known/openid-configuration

# Required by the Nextauth middleware
NEXTAUTH_URL=http://localhost:3000
# Used by NextAuth.js to sign JWTs and emails.
NEXTAUTH_SECRET="NEXTAUTH_SECRET"

# Auth variables for local development environment (Keycloak in Docker)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8085
