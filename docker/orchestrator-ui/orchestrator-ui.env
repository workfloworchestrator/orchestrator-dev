ENVIRONMENT_NAME="Orchestrator Minimal"

ORCHESTRATOR_API_HOST=http://localhost:8080
ORCHESTRATOR_API_PATH=/api
ORCHESTRATOR_GRAPHQL_HOST=http://localhost:8080
ORCHESTRATOR_GRAPHQL_PATH=/api/graphql
NEXTAUTH_SECRET=ToDo

USE_WEB_SOCKETS=true
USE_THEME_TOGGLE=true
SHOW_WORKFLOW_INFORMATION_LINK=true
#TODO change this?
WORKFLOW_INFORMATION_LINK_URL="https://workfloworchestrator.org/"
#TODO is this the websocket URL for the client browser to connect to the NGINX backend, or for NGINX to connect to the orchestrator container?
ORCHESTRATOR_WEBSOCKET_URL="ws://localhost:8080/api/ws/events"

OAUTH2_CLIENT_ID=orchestrator-frontend
#TODO shouldn't this be configured? I think this is backend only?
OAUTH2_CLIENT_SECRET=""
NEXTAUTH_PROVIDER_ID=keycloak
NEXTAUTH_PROVIDER_NAME=Keycloak
NEXTAUTH_AUTHORIZATION_SCOPE_OVERRIDE="openid profile email"
#TODO this should point to keycloak and be reachable by your browser (So localhost, not your container host)
OIDC_CONF_FULL_WELL_KNOWN_URL=http://127.0.0.1:8085/realms/orchestrator/.well-known/openid-configuration
OAUTH2_ACTIVE=true
NEXTAUTH_URL=http://localhost:3000
AO_STACK_STATUS_URL=""
ENABLE_AO_STACK_STATUS=false
ACTIVATE_PYDANTIC_FORMS=true
