LOG_LEVEL=INFO
WATCHFILES_FORCE_POLLING="true"
DATABASE_URI="postgresql+psycopg://nwa:nwa@postgres/orchestrator-core"
ENABLE_WEBSOCKETS="True"
TRANSLATIONS_DIR="/home/orchestrator/translations"
WEBSOCKET_BROADCASTER_URL="redis://:nwa@redis:6379"

# OIDC settings
OAUTH2_ACTIVE=True
OAUTH2_AUTHORIZATION_ACTIVE=True
OAUTH2_RESOURCE_SERVER_ID=orchestrator-backend
# Established in docker/keycloak/realm-import.json
OAUTH2_RESOURCE_SERVER_SECRET=plaintext-orchestrator-backend-secret

# OIDC URLs
# Note that this is instead localhost as long as we share networking with Keycloak!
#_KEYCLOAK_HOST=http://keycloak:8085
_KEYCLOAK_HOST=http://127.0.0.1:8085
_KEYCLOAK_REALM=orchestrator
_KEYCLOAK_AUTH_PREFIX=${_KEYCLOAK_HOST}/auth/realms/${_KEYCLOAK_REALM}/protocol/openid-connect/
# General config
OIDC_CONF_URL=${_KEYCLOAK_HOST}/realms/${_KEYCLOAK_REALM}/.well-known/openid-configuration
# Need to fetch cert for JWT decoding
OAUTH2_CERT_URL="${_KEYCLOAK_HOST}/realms/${_KEYCLOAK_REALM}/protocol/openid-connect/certs"
# From https://workfloworchestrator.org/orchestrator-core/reference-docs/auth-backend-and-frontend/#backend_1
# URLs for auth flow
OAUTH2_TOKEN_URL=${_KEYCLOAK_AUTH_PREFIX}/token
OAUTH2_AUTHORIZE_URL=${_KEYCLOAK_AUTH_PREFIX}/auth
OAUTH2_TOKEN_CHECK_URL=${_KEYCLOAK_AUTH_PREFIX}/token/introspect

CACHE_URI=redis://:nwa@redis:6379/0

# Uvicorn worker processes: increase this in production
UVICORN_WORKERS=2

# Directory inside the container to optionally run with a different orchestrator-core version
# Comment this line out to disable this behavior.
CORE_OVERRIDE=/home/orchestrator/orchestrator-core
# Note: you should also set CORE_DIR=../orchestrator-core/ in the top-level .env

### Embeddings configuration
# Please refer to the documentation in docker/embeddings/README.md
EMBEDDING_API_ENABLED=False
EMBEDDING_API_BASE=http://embeddings:80/v1
EMBEDDING_API_KEY=non-empty
EMBEDDING_DIMENSION=384
# Not required when using OpenAI
EMBEDDING_MAX_BATCH_SIZE=32
