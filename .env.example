export TESTING=1
export PYTHONUNBUFFERED=1
export LOG_LEVEL=DEBUG
export WEBSOCKET_BROADCASTER_URL="redis://localhost:6379"

# Orchestrator core image tag to use.
# Must be compatible with pinned version of orchestrator-core in pyproject.toml.
export ORCH_BACKEND_TAG=ghcr.io/workfloworchestrator/orchestrator-core:5.6.0rc1

# Paths (relative to docker-compose.yml) to local Python library repos to mount into
# the container, install in editable mode, and watch.
# orchestrator-core is enabled by default; uncomment the others to load them.
# If a path doesn't contain a pyproject.toml, the version from uv.lock is used instead.
export CORE_SRC=../orchestrator-core/
#export FORMS_SRC=../pydantic-forms/
#export OAUTH2LIB_SRC=../oauth2-lib/
#export NWASTDLIB_SRC=../nwa-stdlib/

# Where to mount the above inside the orch container.
# Uncomment these lines out to customize the target directory.
#export CORE_DST=/home/orchestrator/orchestrator-core
#export FORMS_DST=/home/orchestrator/pydantic-forms
#export OAUTH2LIB_DST=/home/orchestrator/oauth2-lib
#export NWASTDLIB_DST=/home/orchestrator/nwa-stdlib


export EMBEDDING_API_KEY=None

# Path (relative to docker-compose.yml) to a local example-orchestrator-ui repo.
# Used as the build context for the orchestrator-ui image; it is not hot-reloaded,
# so rebuild with `docker compose up --build orchestrator-ui` after changing it.
# Required repo; defaults to ../example-orchestrator-ui when unset.
export ORCH_UI_DIR=../example-orchestrator-ui

# Path (relative to docker-compose.yml) to a local orchestrator-ui-library repo.
# When set, the UI uses this clone instead of the npm release and hot-reloads it.
# Comment it out to use the version pinned in example-orchestrator-ui's package.json.
# Run `docker compose up -d orchestrator-ui` after changing it.
export ORCH_UI_LIB_DIR=../orchestrator-ui-library

