export TESTING=1
export PYTHONUNBUFFERED=1
export LOG_LEVEL=DEBUG
export WEBSOCKET_BROADCASTER_URL="redis://localhost:6379"

# Orchestrator core image tag to use.
# Must be compatible with pinned version of orchestrator-core in pyproject.toml.
export ORCH_BACKEND_TAG=ghcr.io/workfloworchestrator/orchestrator-core:5.5.0

# Path (relative to docker-compose.yml) to a local orchestrator-core repo to mount into
# the container, install, and watch.
export CORE_DIR=../orchestrator-core/

export EMBEDDING_API_KEY=None

# Path (relative to docker-compose.yml) to a local example-orchestrator-ui repo to
# bind-mount into the container and serve with `next dev` for hot-reload development.
# This variable is required to start the orchestrator-ui service.
export ORCH_UI_DIR=../example-orchestrator-ui

# Path (relative to docker-compose.yml) to a local orchestrator-ui-library repo to
# bind-mount and npm-link into the container for component library development.
# When set, the library is built with `tsup --watch` and linked into the app.
# When unset, the library version from the app's package.json is used.
export ORCH_UI_LIB_DIR=../orchestrator-ui-library

